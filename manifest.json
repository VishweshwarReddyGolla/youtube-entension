{
  "manifest_version": 3,
  "name": "YouTube Focus Mode",
  "version": "1.1",
  "description": "Distraction-free YouTube for focused learning",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}
